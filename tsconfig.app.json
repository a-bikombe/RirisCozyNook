{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/app",
        "types": [],
        "paths": {
            "@pages/*": [
                "./src/app/pages/*"
            ],
            "@components/*": [
                "./src/app/components/*"
            ],
            "@models/*": [
                "./src/app/models/*"
            ],
            "@services/*": [
                "./src/app/services/*"
            ],
            "@constants/*": [
                "./src/app/constants/*"
            ],
            "@env/*": [
                "./env/*"
            ]
        }
    },
    "files": ["src/main.ts"],
    "include": ["src/**/*.d.ts"]
}